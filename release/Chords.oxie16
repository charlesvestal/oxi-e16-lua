{"title":"Chords","icon":[0,0,63,252,37,164,37,164,37,164,37,164,37,164,37,164,37,164,37,164,36,36,36,36,36,36,36,36,63,252,0,0],"selectedPreset":0,"color":82,"transmitMode":0,"pcOnEntry":0,"bankOnEntry":65535,"recentPage":0,"recentPreset":0,"transmitOnSceneEntry":0,"transmitOnPageSwitch":0,"transmitOnPresetLoad":0,"smartTransmit":15,"outputOnEntry":0,"holdMode":0,"acceleration":3,"code":{"code":"local D=[=[CE1?DILS KO9?DILQ FD4?DLNS A6/?DNS CH1?@INS H66?FNU KD9=DELS J58DKU KO9@EKPU HH6@ENPS J>8?DNU CB1:?DLU FO4:?DLS A?;?GNU KD9@EIPS JM8?DHNQ HE6ELP DD2ILN KD9GIP F64GIP AE;IJQ FF4EJN K99DIL DO2DIN HH6EGLP C:=GLP DD>ILN F?4GNP DO>INP CH=KLNS AE;JQU C>=NPS FD4DKN F84GJP KD9GIP K79HLN J:8GKN CM=GJM HE6ELP AJ;IKPQ K99ILP L=:ILO F0;GLP CN=GLM HH6EGLP AF;EIL FA4DIN AJ;EIKP DE2LMT IH7HMQR LD:HJQ KN9HIO GD5LOQ F<4JOR KM9IOR DH>LMOT LO:JLQ K:9HLO IE7FMQ BJ<JLQR G95HLQ F:4GJO DE>HLM BF<FJM G95HLQ F:4GJO DE2HLM IJ7EGLM BD<GJL KE9GHO DE>HLM I>7HJM KH9GHJO GD5LOQ F:4JOS KE9HOS G95HLQ G75HJP F:4GJO KM9FIO CD=HKM LH:HIKP EE3IMN JJ8FHMN G<5GKP LM:GJP EE3IMN JJ8HMNR HO6HMR G:5HKP LE:HIP EC?IMO EH?IMNP DC>HLN CD=HKM CA=FKM JE,?BFG AE/BEIJ DE2EHLM GE5HKOP FE4GJNO IE+>AEF LE.ADHI CE1DGKL ED3FJMO HD*=ADF KD-@DGI BD0CGJL CE1DGKL FD4GKNP JE,?BFG AD/BFIK I?7CGQV BO<CHNSX FH@CLQVZ D6>EJSZ A:;EJSZ BD<CHJSX KH9EHOSV DF>EJOTX F@@CLSZ BO<CHNSX ID;CGNQV D5>EOV GO5<AGQX I?7CGQV KE9CGLQT BD<CHLSV A0;GKN J18GKP F04GLP H06FIN J18GKP F04GLP H06FIN A0;GKN F04GLP A03GKN C:=GILP A0;GKN A0;GKN H0:FIN F08GLP H06FIN ED3?CJMR GH5?CFMP I:7>CMR JO8>CKPT AO/?BGMR CD1?DIMT ED3?CJMR GH5?CFMP BE<?FJOT L4:AHR JD8?DORT I:7>CMR HO6=BHMR FO4;@FKP ED3>AFKO E43?FM JE8GNR F9@GKP E8?IOR A66KPS FD4KNP H66IKR JE8GNR CE=KLS C:=LPS EM?LOU J:8KNS H06IR F9@KPS CE=KLS E>?IPR JH8INRS]=]local T=[=[Cinematic|Chill House|Gospel Soul|Neo Soul|Lofi R&B|Indie Jazz|Detroit|Lush Pads|Pop Piano|Impressionist|Sad Ballads]=]local B4={\"\",\"m\",\"o\",\"+\",\"s2\",\"s4\",\"6\",\"m6\",\"7\",\"M7\",\"m7\",\"mM7\",\"h7\",\"o7\",\"7s\",\"a9\",\"ma9\",\"69\",\"m69\",\"9\",\"M9\",\"m9\",\"9s\",\"11\",\"m11\",\"M11\",\"13\",\"m13\",\"M13\",\"7b9\",\"7#9\",\"M7#11\",\"m7b9\",\"5\"}local DT=10.1 local A8=16383 local A9,C_HIT=0,50 local A5=12 local NN=\"C C#D D#E F F#G G#A A#B \"local SN={\"tr\",\"oct\",\"vel\",\"gate\",\"strum\",\"dir\",\"ch\",\"out\"}local SV={0,0,100,-1,0,0,1,0}local LO={-12,-2,1,-1,0,0,1,0}local HI={12,2,127,40,20,1,16,15}local H,nh={},0 local Q,qi,qn,qt={},1,0,0 local cur,left=0,0 local A4,shown local A1=0 local function A2(v,lo,hi)return v<lo and lo or v>hi and hi or v end local function B1(v)return v<0 and\"Held\"or v==0 and\"Ltch\"or v//10 ..\".\"..v%10 ..\"s\"end local function B(n)local k=n%12*2+1 return(NN:sub(k,k+1):gsub(\" \",\"\"))end local function A6(k)local s=1 for _=2,k do s=D:find(\" \",s,true)if not s then return end s=s+1 end return s,(D:find(\" \",s,true)or#D+1)-1 end local function B3(s,e)local r=D:byte(s)if s+1>=e then return\"\"end if r==45 then return B(D:byte(s+2)-11+SV[1])..\"?\"end local n,x=B(r-65+SV[1]),B4[D:byte(s+1)-47]if x:sub(1,1)==\"m\"then n,x=n:lower(),x:sub(2)end return(n..x):sub(1,4)end local function B2(n,v)midi.sendMidi(SV[8],0,0x8F+SV[7],n,v)end local function A()for i=1,nh do B2(H[i],0)end nh,qn,cur=0,0,0 end local function A7(s)if s~=shown then page.resetTitle()A4,shown=s,s end end local function A3(k)if k<1 or(k-1)//16+1~=controller.getPage()then return end local s,e=A6(k)local v=s and s+1<e and(D:byte(s+2)-11-24)*A8//72 or 0 leds.updateByIndex((k-1)%16+1,A2(v,0,A8),cur==k and C_HIT or A9)end local function A0(pg)pg=pg or controller.getPage()if pg==A5 then for k=1,8 do local v=SV[k]leds.updateByIndex(k,(v-LO[k])*A8//(HI[k]-LO[k]),A9)slots.update(k,k==1 and(v>0 and\"T+\"or\"T\")..v or k==2 and(v>0 and\"Oc+\"or\"Oc\")..v or k==3 and\"V\"..v or k==4 and B1(v)or k==5 and\"S\"..v*10 or k==6 and(v==1 and\"Down\"or\"Up\")or k==7 and\"Ch\"..v or v==0 and\"All\"or\"O\"..v)end for k=9,16 do leds.updateByIndex(k,0,A9)slots.update(k,\"\")end A7(\"Chord settings\")elseif pg<A5 then local s=A6((pg-1)*16+1)for i=1,16 do local e=s and(D:find(\" \",s,true)or#D+1)-1 slots.update(i,s and B3(s,e)or\"\")A3((pg-1)*16+i)s=e and e+2<=#D and e+2 or nil end local n=1 for t in T:gmatch(\"[^|]+\")do if n==pg then A7(t)end n=n+1 end end end local function B5(k)local was=cur A()A3(was)if was==k and SV[4]==0 then return end local s,e=A6(k)if not s or s+1>=e then return end qn=0 for i=s+2,e do qn=qn+1 Q[qn]=A2(D:byte(i)-11+SV[1]+SV[2]*12,0,127)end if SV[6]==1 then for i=1,qn//2 do Q[i],Q[qn+1-i]=Q[qn+1-i],Q[i]end end qi,qt,cur,left=1,0,k,SV[4]*100 A3(k)end function system.update()if A4 then page.setTitle(A4);A4=nil end while qi<=qn and qt<=0 do B2(Q[qi],SV[3])nh=nh+1 H[nh],qi,qt=Q[qi],qi+1,qt+SV[5]*10 end qt=qt-DT if A1>0 then A1=A1-DT if A1<=0 then A0()end end if left>0 then left=left-DT if left<=0 then local k=cur A()A3(k)end end end function controller.onEncoderTurn(e)local id,d=e.id,e.increment if d==0 or not(id>=33 and id<=40 or id<=16 and e.page<A5)then return end controller.set(id,\"v\",8192)if id<=16 then SV[4]=A2(SV[4]+(d>0 and 1 or-1),LO[4],HI[4])var.set(\"gate\",SV[4])if cur>0 then left=SV[4]*100 end slots.update(id,B1(SV[4]))A1=1000 return end local k=id-32 SV[k]=A2(SV[k]+(k==3 and d or d>0 and 1 or-1),LO[k],HI[k])var.set(SN[k],SV[k])if k==7 or k==8 then A()end A0(e.page)end function controller.onEncoderPress(e)if e.id==49 then A()midi.sendCC(SV[8],SV[7]-1,123,0)return end if e.id<17 or e.id>32 or e.page>=A5 then return end B5((e.page-1)*16+e.id-16)end function controller.onEncoderRelease(e)local k=(e.page-1)*16+e.id-16 if SV[4]<0 and e.id>=17 and e.id<=32 and k==cur then A()A3(k)end end function page.onPageChange(prev,curr)A0(curr)end local function B0()for k=1,8 do var.register(SN[k],\"int\",SV[k])SV[k]=A2(var.get(SN[k]),LO[k],HI[k])end end function page.onVarChange()A()B0()A0()end function page.onInit()B0()for id=1,40 do if id<17 or id>32 then controller.set(id,{manual=true,v=8192})end end system.setUpdateRate(10)A0()end\n","fullScript":"-- CHORDS: 176 chord pads on 11 pages, for the OXI E16 (Lua API >= 1.3.0)\r\n-- By Charles Vestal, https://github.com/charlesvestal/oxi-e16-lua (MIT license)\r\n--\r\n-- Pages 1-11: each page is one chord set (a mood), 16 hand-voiced chords.\r\n--   Push a pad to play its chord. Turn any pad to set the length (Held, Ltch,\r\n--   0.1-4 s; the same setting as encoder 4 on page 12); the pad's label shows\r\n--   it for a second. Labels show chord names, minor chords with a\r\n--   lowercase root (f#11 = F#m11, s = sus, a9 = add9, h7 = half-dim); the ring lights\r\n--   while the chord sounds (its fill follows the bass note). The header shows\r\n--   the set's name.\r\n-- Page 12, settings: 1 transpose (root key, -12..+12) | 2 octave | 3 velocity |\r\n--   4 gate (Held = while the pad is pushed; Ltch = until the next pad, and\r\n--   pushing the same pad again stops; or 0.1-4 s) |\r\n--   5 strum (ms between notes) | 6 strum direction | 7 MIDI channel |\r\n--   8 output port. Push encoder 1 = all notes off.\r\n--\r\n-- The sets are our own: specs in tools/chordgen/specs/, voiced by\r\n-- tools/chordgen/build.py; tools/make_chords.py --dir build/chordgen/sets\r\n-- writes the data block below. Settings persist in scene variables:\r\n-- tr oct vel gate strum dir ch out.\r\n\r\n--@assign id=1  abbr=\"Pad1\"  name=\"Pad 1 length\" l=0 h=127 manual=true g=1\r\n--@assign id=2  abbr=\"Pad2\"  name=\"Pad 2 length\" l=0 h=127 manual=true g=2\r\n--@assign id=3  abbr=\"Pad3\"  name=\"Pad 3 length\" l=0 h=127 manual=true g=3\r\n--@assign id=4  abbr=\"Pad4\"  name=\"Pad 4 length\" l=0 h=127 manual=true g=4\r\n--@assign id=5  abbr=\"Pad5\"  name=\"Pad 5 length\" l=0 h=127 manual=true g=5\r\n--@assign id=6  abbr=\"Pad6\"  name=\"Pad 6 length\" l=0 h=127 manual=true g=6\r\n--@assign id=7  abbr=\"Pad7\"  name=\"Pad 7 length\" l=0 h=127 manual=true g=7\r\n--@assign id=8  abbr=\"Pad8\"  name=\"Pad 8 length\" l=0 h=127 manual=true g=8\r\n--@assign id=9  abbr=\"Pad9\"  name=\"Pad 9 length\" l=0 h=127 manual=true g=9\r\n--@assign id=10 abbr=\"Pd10\" name=\"Pad 10 length\" l=0 h=127 manual=true g=10\r\n--@assign id=11 abbr=\"Pd11\" name=\"Pad 11 length\" l=0 h=127 manual=true g=11\r\n--@assign id=12 abbr=\"Pd12\" name=\"Pad 12 length\" l=0 h=127 manual=true g=12\r\n--@assign id=13 abbr=\"Pd13\" name=\"Pad 13 length\" l=0 h=127 manual=true g=13\r\n--@assign id=14 abbr=\"Pd14\" name=\"Pad 14 length\" l=0 h=127 manual=true g=14\r\n--@assign id=15 abbr=\"Pd15\" name=\"Pad 15 length\" l=0 h=127 manual=true g=15\r\n--@assign id=16 abbr=\"Pd16\" name=\"Pad 16 length\" l=0 h=127 manual=true g=16\r\n--@assign id=17 abbr=\"Pad1\"  name=\"Pad 1\"  p=true g=1\r\n--@assign id=18 abbr=\"Pad2\"  name=\"Pad 2\"  p=true g=2\r\n--@assign id=19 abbr=\"Pad3\"  name=\"Pad 3\"  p=true g=3\r\n--@assign id=20 abbr=\"Pad4\"  name=\"Pad 4\"  p=true g=4\r\n--@assign id=21 abbr=\"Pad5\"  name=\"Pad 5\"  p=true g=5\r\n--@assign id=22 abbr=\"Pad6\"  name=\"Pad 6\"  p=true g=6\r\n--@assign id=23 abbr=\"Pad7\"  name=\"Pad 7\"  p=true g=7\r\n--@assign id=24 abbr=\"Pad8\"  name=\"Pad 8\"  p=true g=8\r\n--@assign id=25 abbr=\"Pad9\"  name=\"Pad 9\"  p=true g=9\r\n--@assign id=26 abbr=\"Pd10\"  name=\"Pad 10\" p=true g=10\r\n--@assign id=27 abbr=\"Pd11\"  name=\"Pad 11\" p=true g=11\r\n--@assign id=28 abbr=\"Pd12\"  name=\"Pad 12\" p=true g=12\r\n--@assign id=29 abbr=\"Pd13\"  name=\"Pad 13\" p=true g=13\r\n--@assign id=30 abbr=\"Pd14\"  name=\"Pad 14\" p=true g=14\r\n--@assign id=31 abbr=\"Pd15\"  name=\"Pad 15\" p=true g=15\r\n--@assign id=32 abbr=\"Pd16\"  name=\"Pad 16\" p=true g=16\r\n--@assign id=33 abbr=\"Trns\" name=\"Transpose\"    l=0 h=127 manual=true g=17\r\n--@assign id=49 abbr=\"Trns\" name=\"All notes off\" p=true g=17\r\n--@assign id=34 abbr=\"Oct\"  name=\"Octave\"       l=0 h=127 manual=true g=18\r\n--@assign id=35 abbr=\"Vel\"  name=\"Velocity\"     l=0 h=127 manual=true g=19\r\n--@assign id=36 abbr=\"Gate\" name=\"Gate\"         l=0 h=127 manual=true g=20\r\n--@assign id=37 abbr=\"Strm\" name=\"Strum\"        l=0 h=127 manual=true g=21\r\n--@assign id=38 abbr=\"Dir\"  name=\"Strum direction\" l=0 h=127 manual=true g=22\r\n--@assign id=39 abbr=\"Chan\" name=\"MIDI channel\" l=0 h=127 manual=true g=23\r\n--@assign id=40 abbr=\"Out\"  name=\"Output port\"  l=0 h=127 manual=true g=24\r\n\r\n-- D: one token per pad, space separated: root pitch class (\"A\" = C ... \"L\" = B,\r\n-- \"-\" = unnamed), suffix index (SUF[byte - 47]), then notes as bytes (note + 11).\r\n-- T: page titles separated by \"|\".\r\n-- BEGIN CHORD DATA (generated by tools/make_chords.py)\r\n-- pages: Cine,ChHo,GoSo,NeSo,LoR,InJa,Detr,LuPa,PoPi,Impr,SaBa,Set\r\nlocal D = [=[CE1?DILS KO9?DILQ FD4?DLNS A6/?DNS CH1?@INS H66?FNU KD9=DELS J58DKU KO9@EKPU HH6@ENPS J>8?DNU CB1:?DLU FO4:?DLS A?;?GNU KD9@EIPS JM8?DHNQ HE6ELP DD2ILN KD9GIP F64GIP AE;IJQ FF4EJN K99DIL DO2DIN HH6EGLP C:=GLP DD>ILN F?4GNP DO>INP CH=KLNS AE;JQU C>=NPS FD4DKN F84GJP KD9GIP K79HLN J:8GKN CM=GJM HE6ELP AJ;IKPQ K99ILP L=:ILO F0;GLP CN=GLM HH6EGLP AF;EIL FA4DIN AJ;EIKP DE2LMT IH7HMQR LD:HJQ KN9HIO GD5LOQ F<4JOR KM9IOR DH>LMOT LO:JLQ K:9HLO IE7FMQ BJ<JLQR G95HLQ F:4GJO DE>HLM BF<FJM G95HLQ F:4GJO DE2HLM IJ7EGLM BD<GJL KE9GHO DE>HLM I>7HJM KH9GHJO GD5LOQ F:4JOS KE9HOS G95HLQ G75HJP F:4GJO KM9FIO CD=HKM LH:HIKP EE3IMN JJ8FHMN G<5GKP LM:GJP EE3IMN JJ8HMNR HO6HMR G:5HKP LE:HIP EC?IMO EH?IMNP DC>HLN CD=HKM CA=FKM JE,?BFG AE/BEIJ DE2EHLM GE5HKOP FE4GJNO IE+>AEF LE.ADHI CE1DGKL ED3FJMO HD*=ADF KD-@DGI BD0CGJL CE1DGKL FD4GKNP JE,?BFG AD/BFIK I?7CGQV BO<CHNSX FH@CLQVZ D6>EJSZ A:;EJSZ BD<CHJSX KH9EHOSV DF>EJOTX F@@CLSZ BO<CHNSX ID;CGNQV D5>EOV GO5<AGQX I?7CGQV KE9CGLQT BD<CHLSV A0;GKN J18GKP F04GLP H06FIN J18GKP F04GLP H06FIN A0;GKN F04GLP A03GKN C:=GILP A0;GKN A0;GKN H0:FIN F08GLP H06FIN ED3?CJMR GH5?CFMP I:7>CMR JO8>CKPT AO/?BGMR CD1?DIMT ED3?CJMR GH5?CFMP BE<?FJOT L4:AHR JD8?DORT I:7>CMR HO6=BHMR FO4;@FKP ED3>AFKO E43?FM JE8GNR F9@GKP E8?IOR A66KPS FD4KNP H66IKR JE8GNR CE=KLS C:=LPS EM?LOU J:8KNS H06IR F9@KPS CE=KLS E>?IPR JH8INRS]=]\r\nlocal T = [=[Cinematic|Chill House|Gospel Soul|Neo Soul|Lofi R&B|Indie Jazz|Detroit|Lush Pads|Pop Piano|Impressionist|Sad Ballads]=]\r\nlocal SUF = {\"\", \"m\", \"o\", \"+\", \"s2\", \"s4\", \"6\", \"m6\", \"7\", \"M7\", \"m7\", \"mM7\", \"h7\", \"o7\", \"7s\", \"a9\", \"ma9\", \"69\", \"m69\", \"9\", \"M9\", \"m9\", \"9s\", \"11\", \"m11\", \"M11\", \"13\", \"m13\", \"M13\", \"7b9\", \"7#9\", \"M7#11\", \"m7b9\", \"5\"}\r\n-- END CHORD DATA\r\n\r\nlocal DT = 10.1            -- real update period: firmware fires after > 10 ms\r\nlocal FULL = 16383\r\nlocal C_ON, C_HIT = 0, 50  -- LED color: index into the app's 100-color palette\r\nlocal SETP = 12            -- settings page; pads are on pages 1-11\r\nlocal NN = \"C C#D D#E F F#G G#A A#B \"\r\n\r\n-- Settings (page 12, ids 33-40). Gate is in 100 ms (-1 = Held, 0 = Ltch), strum in 10 ms.\r\nlocal SN = {\"tr\", \"oct\", \"vel\", \"gate\", \"strum\", \"dir\", \"ch\", \"out\"}\r\nlocal SV = {0, 0, 100, -1, 0, 0, 1, 0}\r\nlocal LO = {-12, -2, 1, -1, 0, 0, 1, 0}\r\nlocal HI = {12, 2, 127, 40, 20, 1, 16, 15}\r\n\r\nlocal H, nh = {}, 0        -- notes sounding\r\nlocal Q, qi, qn, qt = {}, 1, 0, 0   -- strum queue: notes, next, count, ms to next\r\nlocal cur, left = 0, 0     -- sounding pad (1-176); ms until release (<= 0: none)\r\nlocal title, shown         -- pending / displayed header text\r\nlocal flash = 0            -- ms left showing the length on a pad label\r\n\r\nlocal function clamp(v, lo, hi)\r\n  return v < lo and lo or v > hi and hi or v\r\nend\r\n\r\nlocal function glab(v) return v < 0 and \"Held\" or v == 0 and \"Ltch\" or v // 10 .. \".\" .. v % 10 .. \"s\" end\r\n\r\nlocal function nname(n)\r\n  local k = n % 12 * 2 + 1\r\n  return (NN:sub(k, k + 1):gsub(\" \", \"\"))\r\nend\r\n\r\n-- Start and end of pad k's token in D (k = 1-176), or nil past the end.\r\nlocal function tok(k)\r\n  local s = 1\r\n  for _ = 2, k do\r\n    s = D:find(\" \", s, true)\r\n    if not s then return end\r\n    s = s + 1\r\n  end\r\n  return s, (D:find(\" \", s, true) or #D + 1) - 1\r\nend\r\n\r\nlocal function label(s, e)\r\n  local r = D:byte(s)\r\n  if s + 1 >= e then return \"\" end\r\n  if r == 45 then return nname(D:byte(s + 2) - 11 + SV[1]) .. \"?\" end\r\n  local n, x = nname(r - 65 + SV[1]), SUF[D:byte(s + 1) - 47]\r\n  if x:sub(1, 1) == \"m\" then n, x = n:lower(), x:sub(2) end   -- minor: \"f#11\"\r\n  return (n .. x):sub(1, 4)\r\nend\r\n\r\nlocal function send(n, v) midi.sendMidi(SV[8], 0, 0x8F + SV[7], n, v) end\r\n\r\nlocal function offAll()\r\n  for i = 1, nh do send(H[i], 0) end\r\n  nh, qn, cur = 0, 0, 0\r\nend\r\n\r\nlocal function setTitle(s)\r\n  if s ~= shown then\r\n    page.resetTitle()                 -- title freeze workaround: set on next tick\r\n    title, shown = s, s\r\n  end\r\nend\r\n\r\n-- Ring of pad k, if its page is showing.\r\nlocal function drawPad(k)\r\n  if k < 1 or (k - 1) // 16 + 1 ~= controller.getPage() then return end\r\n  local s, e = tok(k)\r\n  local v = s and s + 1 < e and (D:byte(s + 2) - 11 - 24) * FULL // 72 or 0\r\n  leds.updateByIndex((k - 1) % 16 + 1, clamp(v, 0, FULL), cur == k and C_HIT or C_ON)\r\nend\r\n\r\nlocal function drawAll(pg)\r\n  pg = pg or controller.getPage()\r\n  if pg == SETP then\r\n    for k = 1, 8 do\r\n      local v = SV[k]\r\n      leds.updateByIndex(k, (v - LO[k]) * FULL // (HI[k] - LO[k]), C_ON)\r\n      slots.update(k, k == 1 and (v > 0 and \"T+\" or \"T\") .. v or k == 2 and (v > 0 and \"Oc+\" or \"Oc\") .. v\r\n        or k == 3 and \"V\" .. v or k == 4 and glab(v)\r\n        or k == 5 and \"S\" .. v * 10 or k == 6 and (v == 1 and \"Down\" or \"Up\")\r\n        or k == 7 and \"Ch\" .. v or v == 0 and \"All\" or \"O\" .. v)\r\n    end\r\n    for k = 9, 16 do\r\n      leds.updateByIndex(k, 0, C_ON)\r\n      slots.update(k, \"\")\r\n    end\r\n    setTitle(\"Chord settings\")\r\n  elseif pg < SETP then\r\n    local s = tok((pg - 1) * 16 + 1)\r\n    for i = 1, 16 do\r\n      local e = s and (D:find(\" \", s, true) or #D + 1) - 1\r\n      slots.update(i, s and label(s, e) or \"\")\r\n      drawPad((pg - 1) * 16 + i)\r\n      s = e and e + 2 <= #D and e + 2 or nil\r\n    end\r\n    local n = 1\r\n    for t in T:gmatch(\"[^|]+\") do\r\n      if n == pg then setTitle(t) end\r\n      n = n + 1\r\n    end\r\n  end\r\nend\r\n\r\n-- Play pad k: queue its notes for the strum.\r\nlocal function play(k)\r\n  local was = cur\r\n  offAll()\r\n  drawPad(was)\r\n  if was == k and SV[4] == 0 then return end   -- Ltch: same pad again stops\r\n  local s, e = tok(k)\r\n  if not s or s + 1 >= e then return end\r\n  qn = 0\r\n  for i = s + 2, e do\r\n    qn = qn + 1\r\n    Q[qn] = clamp(D:byte(i) - 11 + SV[1] + SV[2] * 12, 0, 127)\r\n  end\r\n  if SV[6] == 1 then                   -- strum down: reverse the order\r\n    for i = 1, qn // 2 do Q[i], Q[qn + 1 - i] = Q[qn + 1 - i], Q[i] end\r\n  end\r\n  qi, qt, cur, left = 1, 0, k, SV[4] * 100\r\n  drawPad(k)\r\nend\r\n\r\nfunction system.update()\r\n  if title then page.setTitle(title); title = nil end\r\n  while qi <= qn and qt <= 0 do        -- strum: send due notes\r\n    send(Q[qi], SV[3])\r\n    nh = nh + 1\r\n    H[nh], qi, qt = Q[qi], qi + 1, qt + SV[5] * 10\r\n  end\r\n  qt = qt - DT\r\n  if flash > 0 then\r\n    flash = flash - DT\r\n    if flash <= 0 then drawAll() end\r\n  end\r\n  if left > 0 then\r\n    left = left - DT\r\n    if left <= 0 then\r\n      local k = cur\r\n      offAll()\r\n      drawPad(k)\r\n    end\r\n  end\r\nend\r\n\r\n-- Turn ids 1-16 set the length on pages 1-11; 33-40 change the settings\r\n-- (page 12). Push ids 17-32 play pads on pages 1-11; 49 is all notes off.\r\nfunction controller.onEncoderTurn(e)\r\n  local id, d = e.id, e.increment\r\n  -- 0 = not a physical turn (recorder, random, group); 255 = non-script control\r\n  if d == 0 or not (id >= 33 and id <= 40 or id <= 16 and e.page < SETP) then return end\r\n  controller.set(id, \"v\", 8192)       -- keep manual encoders off their end stops\r\n  if id <= 16 then\r\n    SV[4] = clamp(SV[4] + (d > 0 and 1 or -1), LO[4], HI[4])\r\n    var.set(\"gate\", SV[4])\r\n    if cur > 0 then left = SV[4] * 100 end   -- the sounding chord follows: Held/Ltch keep it\r\n    slots.update(id, glab(SV[4]))\r\n    flash = 1000\r\n    return\r\n  end\r\n  local k = id - 32\r\n  SV[k] = clamp(SV[k] + (k == 3 and d or d > 0 and 1 or -1), LO[k], HI[k])\r\n  var.set(SN[k], SV[k])\r\n  if k == 7 or k == 8 then offAll() end\r\n  drawAll(e.page)\r\nend\r\n\r\nfunction controller.onEncoderPress(e)\r\n  if e.id == 49 then\r\n    offAll()\r\n    midi.sendCC(SV[8], SV[7] - 1, 123, 0)\r\n    return\r\n  end\r\n  if e.id < 17 or e.id > 32 or e.page >= SETP then return end\r\n  play((e.page - 1) * 16 + e.id - 16)\r\nend\r\n\r\n-- Held: letting go of the sounding pad releases its chord. (id and page are\r\n-- the ones from the push.)\r\nfunction controller.onEncoderRelease(e)\r\n  local k = (e.page - 1) * 16 + e.id - 16\r\n  if SV[4] < 0 and e.id >= 17 and e.id <= 32 and k == cur then\r\n    offAll()\r\n    drawPad(k)\r\n  end\r\nend\r\n\r\nfunction page.onPageChange(prev, curr)\r\n  drawAll(curr)                       -- getPage() may not report curr yet\r\nend\r\n\r\nlocal function pull()\r\n  for k = 1, 8 do\r\n    var.register(SN[k], \"int\", SV[k])\r\n    SV[k] = clamp(var.get(SN[k]), LO[k], HI[k])\r\n  end\r\nend\r\n\r\nfunction page.onVarChange()\r\n  offAll()\r\n  pull()\r\n  drawAll()\r\nend\r\n\r\nfunction page.onInit()\r\n  pull()\r\n  for id = 1, 40 do\r\n    if id < 17 or id > 32 then controller.set(id, {manual = true, v = 8192}) end\r\n  end\r\n  system.setUpdateRate(10)\r\n  drawAll()\r\nend\r\n","scriptName":"chords"},"pages":[{"title":"Cine","output":0,"channel":1,"encoders":[{"name":"Pad1","abbr":"Pad1","color":0,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":17,"nr2":11,"output":15,"scriptId":17},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":1,"nr2":0,"output":12,"scriptId":1},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pad2","abbr":"Pad2","color":6,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":2,"nr2":2,"output":0,"scriptId":18},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":2,"nr2":0,"output":12,"scriptId":2},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pad3","abbr":"Pad3","color":12,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":3,"nr2":3,"output":0,"scriptId":19},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":3,"nr2":0,"output":12,"scriptId":3},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pad4","abbr":"Pad4","color":18,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":17,"nr2":1,"output":15,"scriptId":20},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":4,"nr2":0,"output":12,"scriptId":4},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pad5","abbr":"Pad5","color":24,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":5,"nr2":5,"output":0,"scriptId":21},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":5,"nr2":0,"output":12,"scriptId":5},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pad6","abbr":"Pad6","color":30,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":6,"nr2":6,"output":0,"scriptId":22},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":6,"nr2":0,"output":12,"scriptId":6},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pad7","abbr":"Pad7","color":36,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":7,"nr2":7,"output":0,"scriptId":23},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":7,"nr2":0,"output":12,"scriptId":7},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pad8","abbr":"Pad8","color":42,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":8,"nr2":8,"output":0,"scriptId":24},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":8,"nr2":0,"output":12,"scriptId":8},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pad9","abbr":"Pad9","color":48,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":9,"nr2":9,"output":0,"scriptId":25},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":9,"nr2":0,"output":12,"scriptId":9},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pd10","abbr":"Pd10","color":54,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":10,"nr2":10,"output":0,"scriptId":26},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":10,"nr2":0,"output":12,"scriptId":10},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pd11","abbr":"Pd11","color":60,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":11,"nr2":11,"output":0,"scriptId":27},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":11,"nr2":0,"output":12,"scriptId":11},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pd12","abbr":"Pd12","color":66,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":12,"nr2":12,"output":0,"scriptId":28},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":12,"nr2":0,"output":12,"scriptId":12},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pd13","abbr":"Pd13","color":72,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":13,"nr2":13,"output":0,"scriptId":29},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":13,"nr2":0,"output":12,"scriptId":13},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pd14","abbr":"Pd14","color":78,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":14,"nr2":14,"output":0,"scriptId":30},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":14,"nr2":0,"output":12,"scriptId":14},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pd15","abbr":"Pd15","color":84,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":15,"nr2":15,"output":0,"scriptId":31},"turn_actions":[{"instrument":127,"parameter":0,"type":11,"display":10,"mode":14,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":15,"nr2":0,"output":12,"scriptId":15},{"instrument":127,"parameter":0,"type":0,"display":10,"mode":3,"channel":0,"lower":0,"upper":127,"defaultValue":0,"nr1":0,"nr2":0,"output":12,"scriptId":0}],"color2":0},{"name":"Pd16","abbr":"Pd16","color":90,"push_action":{"instrument":127,"parameter":0,"type":12,"display":0,"mode":0,"channel":0,"lower":0,"upper":0,"nr1":16,"nr2":16,"output":0,"script